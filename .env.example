# SoroDoc Configuration
# Copy this file to .env and fill in your values.

# Anthropic API key for AI documentation generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT secret for API authentication
JWT_SECRET=change-me-to-a-random-secret

# API server configuration
PORT=3001
HOST=0.0.0.0

# Database (Postgres)
POSTGRES_URL=postgresql://sorodoc:sorodoc@localhost:5432/sorodoc

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# Portal configuration (optional)
PORTAL_URL=https://portal.sorodoc.dev

# Log level
LOG_LEVEL=info
